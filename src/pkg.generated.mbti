pub fn Server::resource_template(Self, uri_template~ : String, name? : String, title? : String, description? : String, mime_type? : String, icons? : Array[Icon], annotations? : Annotations, meta? : Json, async (RequestContext, String, Map[String, String]) -> HandlerOutcome[ReadResourceResult] raise McpError) -> Unit raise McpError
pub fn Server::supports_protocol_version(Self, String) -> Bool
pub fn[A : @json.FromJson + @schema.JsonSchema] Server::tool(Self, name~ : String, title? : String, description? : String, input_schema? : Json, output_schema? : Json, annotations? : ToolAnnotations, icons? : Array[Icon], meta? : Json, async (RequestContext, A) -> HandlerOutcome[CallToolResult] raise McpError) -> Unit raise McpError
pub fn Server::tool_descriptor(Self, String) -> Tool?
pub fn Server::tool_raw(Self, name~ : String, title? : String, description? : String, input_schema? : Json, output_schema? : Json, annotations? : ToolAnnotations, icons? : Array[Icon], meta? : Json, async (RequestContext, Json) -> HandlerOutcome[CallToolResult] raise McpError) -> Unit raise McpError

